// ============================================
// Supabase 配置模板
// 复制此文件为 .env.local 并填入实际值
// ============================================

# Supabase 项目 URL (来自 Supabase Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (公开密钥, 客户端使用)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (服务端密钥, 仅 API 路由使用, 严格保密)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 虎皮椒支付配置 (后期配置)
XUNHUPAY_APPID=your-appid
XUNHUPAY_APPSECRET=your-appsecret
XUNHUPAY_NOTIFY_URL=https://aiitmc.online/api/payment/notify

# 站点配置
NEXT_PUBLIC_SITE_URL=https://aiitmc.online
NEXT_PUBLIC_SITE_NAME=AIITMC Online
